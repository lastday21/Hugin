HUGIN_ENVIRONMENT=development
HUGIN_API_HOST=127.0.0.1
HUGIN_API_PORT=8000
HUGIN_LOG_LEVEL=INFO
HUGIN_DOCKER_PORT=8010
HUGIN_DATABASE_HOST=127.0.0.1
HUGIN_DATABASE_PORT=5432
HUGIN_DATABASE_NAME=hugin
HUGIN_DATABASE_USER=hugin
HUGIN_DATABASE_PASSWORD=replace-with-a-long-random-password
HUGIN_POSTGRES_PORT=5432
HUGIN_HH_BROWSER_TIMEOUT_MS=60000
# Необязательно: исходящий адрес обычной сети, если туннель блокирует hh.ru.
# Замените служебный пример адресом нужного сетевого адаптера.
# HUGIN_HH_BROWSER_SOURCE_IP=192.0.2.10
HUGIN_HH_BACKGROUND_SEARCH_PAGES=3
# За один фоновый цикл подробно разбирать не больше пяти новых вакансий.
HUGIN_HH_BACKGROUND_DETAIL_LIMIT=5
# Единая служба уведомлений отправляет сообщения в Telegram и по почте.
HUGIN_NOTIFICATION_GATEWAY_URL=http://127.0.0.1:8088
# Если путь не задан, ограниченный ключ читается из защищённого хранилища Windows.
# HUGIN_NOTIFICATION_GATEWAY_KEY_FILE=C:\secure\hugin-notifications\service_key
# HUGIN_NOTIFICATION_GATEWAY_TIMEOUT_SECONDS=15
# HUGIN_NOTIFICATION_GATEWAY_CONNECTION_TIMEOUT_SECONDS=120
# HUGIN_HH_RESUMES_URL=https://hh.ru/applicant/resumes
# HUGIN_HH_SEARCH_URL=https://hh.ru/search/vacancy
# HUGIN_DATA_DIR=C:\Users\username\AppData\Local\Hugin
# Настройте ключ безопасной командой hugin-resume-improve configure.
# HUGIN_YANDEX_AI_FOLDER_ID=folder-id
# HUGIN_YANDEX_AI_MODEL=aliceai-llm/latest
# Необязательно: исходящий адрес обычной сети, если туннель обрывает ответы модели.
# Замените служебные примеры актуальными адресами узла и сетевого адаптера.
# HUGIN_YANDEX_AI_HOST_IP=203.0.113.10
# HUGIN_YANDEX_AI_SOURCE_IP=192.0.2.10

HUGIN_ENVIRONMENT=development
HUGIN_API_HOST=127.0.0.1
HUGIN_API_PORT=8000
HUGIN_LOG_LEVEL=INFO
HUGIN_DOCKER_PORT=8010
# normal — обычная работа; gaming — пониженный приоритет и ограничение ресурсов для игры.
HUGIN_RESOURCE_MODE=normal
# Запас перед первой дневной рассылкой; минимум допустим после полного свежего прохода.
HUGIN_APPLICATION_POOL_TARGET=40
HUGIN_APPLICATION_POOL_MINIMUM=30
HUGIN_DATABASE_HOST=127.0.0.1
HUGIN_DATABASE_PORT=5432
HUGIN_DATABASE_NAME=hugin
HUGIN_DATABASE_USER=hugin
HUGIN_DATABASE_PASSWORD=replace-with-a-long-random-password
HUGIN_POSTGRES_PORT=5432
HUGIN_HH_BROWSER_TIMEOUT_MS=60000
# chrome — установленный Chrome с отдельным профилем и штатными расширениями.
# msedge — установленный Microsoft Edge с отдельным профилем и расширениями.
# chromium — прежний комплектный браузер Playwright; его профиль сохраняется отдельно.
HUGIN_HH_BROWSER_CHANNEL=chromium
# Необязательно: исходящий адрес обычной сети, если туннель блокирует hh.ru.
# Замените служебный пример адресом нужного сетевого адаптера.
# HUGIN_HH_BROWSER_SOURCE_IP=192.0.2.10
HUGIN_HH_BACKGROUND_SEARCH_PAGES=3
# За один фоновый цикл подробно разбирать не больше двадцати новых вакансий.
HUGIN_HH_BACKGROUND_DETAIL_LIMIT=20
# Единая служба уведомлений отправляет сообщения в Telegram и по почте.
HUGIN_NOTIFICATION_GATEWAY_URL=http://127.0.0.1:8088
# Если путь не задан, ограниченный ключ читается из защищённого хранилища Windows.
# HUGIN_NOTIFICATION_GATEWAY_KEY_FILE=C:\secure\hugin-notifications\service_key
# HUGIN_NOTIFICATION_GATEWAY_TIMEOUT_SECONDS=15
# HUGIN_NOTIFICATION_GATEWAY_CONNECTION_TIMEOUT_SECONDS=120
# HUGIN_HH_RESUMES_URL=https://hh.ru/applicant/resumes
# HUGIN_HH_SEARCH_URL=https://hh.ru/search/vacancy
# HUGIN_DATA_DIR=C:\Users\username\AppData\Local\Hugin
# Настройте ключ безопасной командой hugin-resume-improve configure.
# HUGIN_YANDEX_AI_FOLDER_ID=folder-id
# HUGIN_YANDEX_AI_MODEL=aliceai-llm/latest
# Лёгкая модель выбирает готовое письмо или вносит небольшую правку.
# HUGIN_YANDEX_AI_ROUTER_MODEL=deepseek-v4-flash/latest
# HUGIN_YANDEX_AI_ROUTER_REASONING_EFFORT=low
# Необязательно: исходящий адрес обычной сети, если туннель обрывает ответы модели.
# Замените служебные примеры актуальными адресами узла и сетевого адаптера.
# HUGIN_YANDEX_AI_HOST_IP=203.0.113.10
# HUGIN_YANDEX_AI_SOURCE_IP=192.0.2.10
# Сопроводительные письма создаются через вход в ChatGPT, без отдельного ключа API.
# HUGIN_CODEX_CLI_PATH=C:\Users\username\AppData\Local\Hugin\codex-cli\node_modules\.bin\codex.cmd
# Existing local Codex chat to wake once when Hugin encounters CAPTCHA; blank disables it.
HUGIN_CAPTCHA_AGENT_THREAD_ID=
# HUGIN_CAPTCHA_AGENT_CODEX_PATH=C:/path/to/codex.exe
# HUGIN_CODEX_LETTER_MODEL=gpt-6.1-sol
# HUGIN_CODEX_LETTER_REASONING_EFFORT=medium
# HUGIN_CODEX_LETTER_TIMEOUT_SECONDS=180
# Короткая проверка неоднозначных сообщений выполняется дешёвой моделью.
# HUGIN_CODEX_REPLY_REQUIREMENT_MODEL=gpt-5.6-luna
# HUGIN_CODEX_REPLY_REQUIREMENT_TIMEOUT_SECONDS=60
